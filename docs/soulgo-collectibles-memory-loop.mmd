%% SoulGo 收集物与记忆闭环（流程约定）
%% 静态池优先：仅当静态池未满足时再走动态生成
%% 合作限定判断上移至「领取」之后、「意图构建」之前（仅此处裁决；主入柜后为执行分叉）
%% 「领取并解锁」= 旅行日记内获取收集物（非打卡瞬间）；打卡成功链路不入橱、不解析掉落池
%% GPS 辅助校验（产品约定）：现阶段以打卡所选城市模拟位置事实，非设备经纬度
%% 日记含用户上传图时：静态候选间读图加权（术语「443」= soul:object:emotion = 4:3:3，见 pickSceneByVisionWeightedScores）
%% 可在 VS Code / GitHub / Notion 等支持 Mermaid 的编辑器中预览

flowchart TD
    UC["用户打卡"]
    CA["核心档案"]
    DG["日记生成服务"]
    GP["生成日记与计划"]
    MS["记忆摘要服务"]
    EM["情景记忆存储"]
    VS["向量化存储服务"]
    VL["向量记忆库"]
    MR["记忆检索"]
    LU["领取并解锁"]
    CJ["合作限定判断（上海）"]
    CI["收集物意图构建"]
    SP["静态池挑选"]
    SAT{"静态池满足？"}
    DY["动态生成尝试"]
    MN["日记主收集物入柜"]
    PE{"须合作追加入柜？"}
    BO["合作追加收集物入柜"]
    UR["更新日记奖励（main/bonus）"]
    CP["橱柜入库与奖励弹窗"]

    UC --> DG
    CA --> DG
    DG --> GP --> MS --> EM --> VS --> VL --> MR --> LU --> CJ --> CI --> SP --> SAT

    SAT -->|"是"| MN
    SAT -->|"否"| DY --> MN

    MN --> PE
    PE -->|"是"| BO --> UR
    PE -->|"否"| UR
    UR --> CP

%% 注：非合作地点仅主奖励一件；上海合作限定时 CJ 已在前序给出资格，PE 仅按该资格执行追加（非再次完整裁决）。
%% 主路径先解一枚主收集物；动态仅在 SAT 为「否」之后参与；不得以动态覆盖已满足的静态结果（实现层见 COLLECTIBLE_POLICY）。
